#!/usr/bin/env node
const fs = require('fs');
const path = require('path');
const execSync = require('child_process').execSync;

const SCRIPT_DIR = __dirname;
let mocksDir = null;
if (fs.existsSync('/tmp/arondo-mocks-dir.txt')) {
  mocksDir = fs.readFileSync('/tmp/arondo-mocks-dir.txt', 'utf8').trim();
}
const CODEX_STATUS_PATH = mocksDir
  ? path.join(mocksDir, 'arondo-codex-status.txt')
  : path.resolve(SCRIPT_DIR, '../../tmux/codex/arondo-codex-status.txt');

const args = process.argv.slice(2);

if (args[0] === 'exec') {
  console.error('session id: 019f9883-1234-5678-9abc-def012345678');
  const promptFile = process.env.ARONDO_PROMPT_FILE;
  let promptContent = '';
  if (promptFile && fs.existsSync(promptFile)) {
    promptContent = fs.readFileSync(promptFile, 'utf8');
  }
  if (promptContent.includes('FAIL_MOCK') || process.env.MOCK_CODEX_FAIL === '1') {
    console.error('Mock codex execution failed!');
    process.exit(1);
  }
  console.log('Mock codex exec');
  process.exit(0);
}

// Interactive mode (e.g. running bare `codex`, used for quota polling via /status)
if (process.env.TMUX) {
  try {
    execSync('tmux clear-history 2>/dev/null');
  } catch (e) {}
}

let statusContent = '';
try {
  statusContent = fs.readFileSync(CODEX_STATUS_PATH, 'utf8');
} catch (e) {
  console.error(`Error reading mock status file: ${e}`);
  process.exit(1);
}

// codex reports resets as "HH:MM on D Mon" for weekly and "HH:MM" for 5h — 24h clock, no timezone.
const targetDateWeekly = new Date(Date.now() + 2 * 24 * 60 * 60 * 1000);
const targetDate5h = new Date(Date.now() + 3 * 60 * 60 * 1000);
const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const hhWeekly = String(targetDateWeekly.getHours()).padStart(2, '0');
const mmWeekly = String(targetDateWeekly.getMinutes()).padStart(2, '0');
const resetsWeeklyStr = `${hhWeekly}:${mmWeekly} on ${targetDateWeekly.getDate()} ${months[targetDateWeekly.getMonth()]}`;
const hh5h = String(targetDate5h.getHours()).padStart(2, '0');
const mm5h = String(targetDate5h.getMinutes()).padStart(2, '0');
const resets5hStr = `${hh5h}:${mm5h}`;

statusContent = statusContent
  .replace(/__resets_weekly__/g, resetsWeeklyStr)
  .replace(/__resets_5h__/g, resets5hStr)
  .replace(/__resets__/g, resetsWeeklyStr);

const statusLines = statusContent.split('\n');
const initialScreen = [
  '╭──────────────────────────────────────────────────────╮',
  '│ >_ OpenAI Codex (v0.153.1)                           │',
  '│                                                      │',
  '│ model:       gpt-5.6-terra medium   /model to change │',
  '│ directory:   /data/arondo                           │',
  '│ permissions: YOLO mode                               │',
  '╰──────────────────────────────────────────────────────╯',
  '',
].join('\n');

process.stdout.write(initialScreen);

if (process.stdin.isTTY) {
  process.stdin.setRawMode(true);
}
process.stdin.setEncoding('utf8');

let buffer = '';
process.stdin.on('data', (key) => {
  for (let i = 0; i < key.length; i++) {
    const char = key[i];
    const code = char.charCodeAt(0);
    if (char === '\r' || char === '\n') {
      const cmd = buffer.trim();
      buffer = '';
      if (cmd === '/status') {
        if (process.env.TMUX) {
          try {
            execSync('tmux clear-history 2>/dev/null');
          } catch (e) {}
        }
        process.stdout.write('\033[H\033[2J');
        process.stdout.write(statusLines.join('\n'));
      }
    } else if (code === 3 || code === 4) { // Ctrl+C or Ctrl+D
      process.exit(0);
    } else {
      buffer += char;
    }
  }
});
