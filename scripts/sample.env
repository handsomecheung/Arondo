# From the repository root, copy this template before using the startup scripts:
# cp scripts/sample.env scripts/.env
# scripts/.env is sourced by Bash; use shell syntax and quote values.
# Keep credentials in scripts/.env, which is ignored by Git.

# Start scripts/run.server.sh, open http://localhost:3251, and sign in with
# the admin access token printed in the server console on first startup.
# Create a runner token in Admin Settings > Runner Tokens, then paste it below
# before starting scripts/run.runner.sh. This is separate from the admin token.
ARONDO_RUNNER_TOKEN_LOCALDEV=''

# Optional server settings must be exported to reach the server process.
# export ARONDO_CONFIG_DIR="$HOME/.arondo"
# export TYPESAFE_API_KEY='your-api-key'
